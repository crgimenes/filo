; Lists are made with list and read with head, tail and nth. A list never
; changes: list-append and reverse give new ones, and xs stays as it was.
(def xs (list 3 1 2))
(list (head xs) (tail xs) (nth xs 2) (length xs) (list-append xs 4) (reverse xs) xs)
; Output: (list 3 (list 1 2) 2 3 (list 3 1 2 4) (list 2 1 3) (list 3 1 2))
